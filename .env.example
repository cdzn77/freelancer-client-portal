# Run node scripts/setup.mjs to generate the full private .env and .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
ENABLE_PAID_AI=false
AI_HTTP_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:3100
STORAGE_PROVIDER=supabase
ENABLE_PAID_STORAGE=false
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
ENABLE_PAID_EMAIL=false
EMAIL_HTTP_URL=
EMAIL_API_KEY=
ENABLE_SOCIAL=false
SOCIAL_HTTP_URL=
SOCIAL_API_KEY=
ENABLE_ACCOUNTING=false
ACCOUNTING_HTTP_URL=
ACCOUNTING_API_KEY=
# Worker/MCP use a user's short-lived access token, never the service-role key.
PMS_ACCESS_TOKEN=
PMS_WORKSPACE_ID=

# Hosted Supabase uploads bypass serverless request-size limits.
NEXT_PUBLIC_DIRECT_STORAGE_UPLOAD=false

# Native studio assistant uses the AI_* variables above.
# Set AI_PROVIDER=http, ENABLE_PAID_AI=true, AI_HTTP_PROVIDER=openai|anthropic,
# AI_MODEL and a server-only AI_API_KEY to enable drafts and suggestions.
# Requests are scoped, rate-limited, and never auto-apply changes.

# Google Workspace notifications (sender: studio@example.com).
# Configure server-only settings; never use NEXT_PUBLIC_ for these secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3100/api/email/google/callback
# A private random 32-byte key encoded as base64. Keep stable after connecting.
EMAIL_TOKEN_ENCRYPTION_KEY=
PMS_PUBLIC_URL=http://127.0.0.1:3100
ENABLE_NOTIFICATION_EMAIL_WORKER=false
# Optional private random secret; falls back to the server service-role key.
INTAKE_RATE_LIMIT_SECRET=

# Dropbox: server-only values from your own Dropbox OAuth application.
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=
# Optional for confidential-client connections; not required with PKCE.
DROPBOX_APP_SECRET=

# Optional Google notification sender and receipt mailbox allowlist.
NOTIFICATION_SENDER=
EXPENSE_MAILBOXES=
# Public intake requires Turnstile; configure the exact portal hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional website monitoring. The monitored site comes from config/brand.json.
WEBSITE_MONITOR_WORKSPACE=
GA4_PROPERTY_ID=
NETLIFY_SITE_ID=
SEARCH_CONSOLE_PROPERTY=
# Optional Square checkout. Disabled unless explicitly enabled.
SQUARE_CHECKOUT_ENABLED=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
