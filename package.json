{
  "name": "freelancer-client-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "mcp": "tsx services/mcp.ts",
    "worker": "tsx services/worker.ts",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "test:startup": "node --import tsx scripts/check-studio-loading.tsx",
    "test:select": "node --import tsx scripts/check-select.tsx",
    "test:monitor": "node --import tsx scripts/check-website-monitor.ts && node --import tsx scripts/check-monitor-ui.tsx && node --import tsx scripts/check-health-retest.ts",
    "test:expenses": "node --import tsx scripts/check-studio-expenses.tsx && node --import tsx scripts/check-expense-ui.tsx",
    "test:dashboard": "node --import tsx scripts/check-dashboard-board.tsx",
    "test:expense-mail": "node --import tsx scripts/check-expense-mail.ts && node --import tsx scripts/check-expense-mail-ui.tsx",
    "test:members": "node --import tsx scripts/check-member-ui.tsx",
    "test:security": "node --import tsx scripts/check-account-security.tsx",
    "test:onboarding": "node --import tsx scripts/check-onboarding.tsx",
    "test:documents": "node scripts/run-document-check.mjs",
    "test:search": "node --import tsx scripts/check-search-intelligence.ts && node --import tsx scripts/check-monitor-intelligence.ts && node --import tsx scripts/check-search-ui.tsx && node --import tsx scripts/check-chronicles.tsx && node --import tsx scripts/check-crawl-retest.ts && node --import tsx scripts/check-chronicles-provider.ts",
    "test:connected": "node --import tsx scripts/check-connected-workflows.ts",
    "setup": "node scripts/setup.mjs",
    "setup:admin": "node --env-file=.env scripts/create-admin.mjs",
    "test:template": "node --import tsx scripts/check-white-label.tsx && node --test scripts/check-create-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@netlify/functions": "^6.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "frappe-gantt": "^1.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  }
}
